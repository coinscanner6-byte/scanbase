# Copy this file to ".env" and fill in your real database address.
# Never commit the real ".env" file to GitHub.

# This is the connection address for your PostgreSQL database.
# For local testing, you can point this at a fresh local database,
# or at your Railway database's PUBLIC url (found in Railway's dashboard,
# under your Postgres service -> "Connect" tab -> "Public Network").
DATABASE_URL=postgresql://user:password@localhost:5432/scanbase
